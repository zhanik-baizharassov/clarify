# Локально: скопируйте в .env.local (его читают и Next.js, и Prisma CLI).
# Production: те же переменные задаются в Vercel -> Settings -> Environment Variables.

# Database
# Локально: Docker Postgres из docker-compose.yml.
# Production (Neon): для приложения/Vercel берите POOLED url (хост с "-pooler"),
# а для `prisma migrate deploy` и бэкапов - DIRECT url (без "-pooler").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/review_platform?schema=public"

# App
APP_ORIGIN="http://localhost:3000"
APP_NAME="Clarify"

# Mail mode:
# - console  -> печатает OTP код в терминал (только локальная разработка)
# - smtp     -> реальная отправка через SMTP
# - disabled -> ничего не отправляет (например тесты)
# В PRODUCTION MAIL_MODE должен быть "smtp": при console/disabled отправка кода
# в production намеренно отклоняется ошибкой (сборка при этом не падает).
MAIL_MODE="console"

# SMTP (нужно только если MAIL_MODE=smtp)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your.smtp@gmail.com"
SMTP_PASS="YOUR_APP_PASSWORD"
MAIL_FROM="Clarify <your.smtp@gmail.com>"

# Email verification
EMAIL_CODE_PEPPER="CHANGE_ME_LONG_RANDOM_SECRET"
EMAIL_CODE_TTL_MIN=10

# Cron (обязателен в production): секрет для ежедневной очистки
# /api/cron/cleanup (vercel.json). Vercel сам передаёт его как
# "Authorization: Bearer <CRON_SECRET>". Без него endpoint отвечает 500.
# Сгенерировать: openssl rand -hex 32
CRON_SECRET=""

# SEO (optional): verification meta tags and analytics. Leave empty to disable.
GOOGLE_SITE_VERIFICATION=""
YANDEX_VERIFICATION=""
NEXT_PUBLIC_YM_ID=""
